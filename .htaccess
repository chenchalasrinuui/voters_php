RewriteEngine On

# Do not redirect API requests to add a trailing slash
RewriteCond %{REQUEST_URI} ^/voters_php/api/ [NC]
RewriteRule ^ - [E=NO_SLASH_REDIRECT:1]

# Serve existing physical files and directories normally
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Send all API requests through the master router
RewriteRule ^api(?:/.*)?$ routes.php [QSA,L]