<IfModule mod_headers.c>
    # Dynamic Origin reflection for React on localhost:3000, 5173, etc.
    SetEnvIfNoCase Origin "^(http(s)?://.*)$" CLIENT_ORIGIN=$1
    Header always set Access-Control-Allow-Origin "%{CLIENT_ORIGIN}e" env=CLIENT_ORIGIN
    Header always set Access-Control-Allow-Credentials "true" env=CLIENT_ORIGIN
    Header always set Access-Control-Allow-Methods "GET, POST, PUT, PATCH, DELETE, OPTIONS"
    Header always set Access-Control-Allow-Headers "Content-Type, Authorization, X-Requested-With, Accept, Origin, Cache-Control, Pragma, X-User-Id, X-User-Role, X-User-Numeric-Id"
    Header always set Access-Control-Max-Age "86400"
</IfModule>

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Route preflight OPTIONS to cors.php
    RewriteCond %{REQUEST_METHOD} OPTIONS
    RewriteRule ^(.*)$ cors.php [QSA,L]

    # Explicit routing for API endpoints before directory checking to avoid 301 trailing slash redirects
    RewriteRule ^api/upload/?$ routes/upload.php [QSA,L]
    RewriteRule ^api/auth/login/?$ routes/auth.php [QSA,L]
    RewriteRule ^api/auth/?$ routes/auth.php [QSA,L]
    RewriteRule ^api/voters/vote/?$ routes/voters.php?action=vote [QSA,L]
    RewriteRule ^api/voters/flag/?$ routes/voters.php?action=flag [QSA,L]
    RewriteRule ^api/voters/reset-votes/?$ routes/voters.php?action=reset-votes [QSA,L]
    RewriteRule ^api/voters/edit/?$ routes/voters.php?action=edit [QSA,L]
    RewriteRule ^api/voters/?$ routes/voters.php [QSA,L]
    RewriteRule ^api/villages/?$ routes/villages.php [QSA,L]
    RewriteRule ^api/admin/users/?$ routes/admin.php?action=users [QSA,L]
    RewriteRule ^api/admin/stats/?$ routes/admin.php?action=stats [QSA,L]
    RewriteRule ^api/health/?$ routes/health.php [QSA,L]

    # Serve existing physical files and directories
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Send all other API requests through router.php
    RewriteRule ^api(?:/.*)?$ router.php [QSA,L]
    RewriteRule ^backend(?:/.*)?$ router.php [QSA,L]
</IfModule>
