<IfModule mod_headers.c>
    Header unset Access-Control-Allow-Origin
    SetEnvIfNoCase Origin "^(http(s)?://.*)$" CLIENT_ORIGIN=$1
    Header always set Access-Control-Allow-Origin "%{CLIENT_ORIGIN}e" env=CLIENT_ORIGIN
    Header always set Access-Control-Allow-Credentials "true" env=CLIENT_ORIGIN
    Header always set Access-Control-Allow-Methods "GET, POST, PUT, PATCH, DELETE, OPTIONS"
    Header always set Access-Control-Allow-Headers "Content-Type, Authorization, X-Requested-With, Accept, Origin, Cache-Control, Pragma, X-User-Id, X-User-Role, X-User-Numeric-Id, *"
    Header always set Access-Control-Expose-Headers "Content-Length, Content-Type, Authorization, *"
    Header always set Access-Control-Max-Age "86400"
</IfModule>

<IfModule php_module>
    php_value upload_max_filesize 128M
    php_value post_max_size 130M
    php_value memory_limit 512M
    php_value max_execution_time 300
    php_value max_input_time 300
    php_flag display_errors Off
</IfModule>

<IfModule mod_rewrite.c>
    Options -MultiViews
    RewriteEngine On

    # Prevent Apache mod_dir from issuing 301 redirects on directory endpoints without CORS
    DirectorySlash Off

    # Route preflight OPTIONS to cors.php immediately
    RewriteCond %{REQUEST_METHOD} OPTIONS
    RewriteRule ^(.*)$ cors.php [QSA,L]

    # Explicit routing for API endpoints (making trailing slashes optional to prevent drops)
    RewriteRule ^api/villages/delete/?$ api/villages/delete.php [QSA,L]
    RewriteRule ^api/villages/delete/(\d+)/?$ routes/villages.php?action=delete&delete_id=$1 [QSA,L]
    RewriteRule ^api/villages/(\d+)/?$ routes/villages.php?delete_id=$1 [QSA,L]
    RewriteRule ^api/villages/?$ routes/villages.php [QSA,L]

    RewriteRule ^api/upload/?$ routes/upload.php [QSA,L]
    RewriteRule ^api/auth/login/?$ routes/auth.php [QSA,L]
    RewriteRule ^api/auth/?$ routes/auth.php [QSA,L]
    RewriteRule ^api/voters/vote/?$ routes/voters.php?action=vote [QSA,L]
    RewriteRule ^api/voters/out-of-station/?$ routes/voters.php?action=out-of-station [QSA,L]
    RewriteRule ^api/voters/flag/?$ routes/voters.php?action=flag [QSA,L]
    RewriteRule ^api/voters/reset-votes/?$ routes/voters.php?action=reset-votes [QSA,L]
    RewriteRule ^api/voters/edit/?$ api/voters/edit/index.php [QSA,L]
    RewriteRule ^api/voters/?$ routes/voters.php [QSA,L]
    RewriteRule ^api/admin(?!/index\.php(?:/|$))(?:/.*)?$ api/admin/index.php [QSA,L]
    RewriteRule ^api/health/?$ routes/health.php [QSA,L]

    # Serve existing physical files directly (photos, pdfs, scripts, html)
    RewriteCond %{REQUEST_FILENAME} -f
    RewriteRule ^ - [L]

    # Send all other API requests through router.php
    RewriteRule ^api(?:/.*)?$ router.php [QSA,L]
    RewriteRule ^backend(?:/.*)?$ router.php [QSA,L]
</IfModule>