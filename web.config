<?xml version="1.0" encoding="UTF-8"?>
<configuration>
  <system.webServer>
    <rewrite>
      <rules>
        <rule name="Village delete endpoint" stopProcessing="true">
          <match url="^api/villages/delete$" />
          <action type="Rewrite" url="api/villages/delete/index.php" appendQueryString="true" />
        </rule>
      </rules>
    </rewrite>
  </system.webServer>
</configuration>
